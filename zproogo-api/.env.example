# Copy this file to ".env" and edit. Never commit ".env".
PORT=8080

# user:password@host:port/database  (the database must exist; see README step 2)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zproogo
# set to true for cloud databases that require SSL (Neon, Supabase, RDS ...)
DB_SSL=false

# Secrets: use long random values. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
OTP_PEPPER=change-me-to-another-long-random-string

# dev  -> OTP is always 123456, no SMS is sent (matches the app README)
# sms  -> random OTP sent by SMS (needs the SMS_* settings below)
OTP_MODE=dev

# Google Sign-In: the WEB client id (same value as GOOGLE_WEB_CLIENT_ID in the app's src/config.ts)
GOOGLE_WEB_CLIENT_ID=

# oldest app version allowed; older apps see the "update required" screen
MIN_APP_VERSION=1.0.0

# SMS provider (only when OTP_MODE=sms). Currently supported: twilio
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# set to 1 when running behind a reverse proxy / load balancer (nginx, Render, Railway ...)
TRUST_PROXY=
